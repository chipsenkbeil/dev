#!/usr/bin/env bash
# dev: the launcher. It starts luajit on main.lua, which runs every verb.
set -euo pipefail

SYSTEM_BIN_DIRS=(/usr/bin /usr/local/bin)
root_refusal="As root, dev runs only \`dev tools install\` and \`dev tools check\`."

args=()
chdirs=()
while [ "$#" -gt 0 ]; do
    case "$1" in
    --)
        break
        ;;
    --agent)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
            printf 'The --agent flag needs a name.\n' >&2
            exit 2
        fi
        export DEV_AGENT=$2
        shift 2
        ;;
    -C)
        if [ "$#" -lt 2 ] || [ -z "$2" ]; then
            printf "The flag \`-C\` needs a directory.\n" >&2
            exit 2
        fi
        chdirs+=("$2")
        shift 2
        ;;
    --job-timeout)
        args+=("$1")
        shift
        if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
            args+=("$1")
            shift
        fi
        ;;
    *)
        args+=("$1")
        shift
        ;;
    esac
done
set -- ${args[@]+"${args[@]}"} "$@"

luajit=luajit
if [ "$EUID" -eq 0 ] || [ "$(id -u)" -eq 0 ]; then
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    unset DEV_UID DEV_OS BASH_ENV ENV
    unset LUA_PATH LUA_CPATH LUA_INIT LUA_PATH_5_1 LUA_CPATH_5_1 LUA_INIT_5_1 LUA_PATH_5_2 LUA_CPATH_5_2 LUA_INIT_5_2
    luajit=""
    for dir in "${SYSTEM_BIN_DIRS[@]}"; do
        if [ -x "$dir/luajit" ]; then
            luajit=$dir/luajit
            break
        fi
    done
fi

DEV_SELF=$(realpath "${BASH_SOURCE[0]}")
export DEV_SELF
for dir in ${chdirs[@]+"${chdirs[@]}"}; do
    target=$dir
    case "$dir" in
    /*) ;;
    *) target=./$dir ;;
    esac
    cd -P -- "$target" 2>/dev/null || {
        printf "The flag \`-C\` cannot enter %s.\n" "$dir" >&2
        exit 2
    }
done
share=$(cd -P "$(dirname "$DEV_SELF")/../share/dev" && pwd -P)
if [ "$luajit" = luajit ] && [ "${DEV_FROM:-}" != checkout ] && [ -n "${HOME:-}" ]; then
    case "${XDG_STATE_HOME:-}" in
    /*) state=$XDG_STATE_HOME ;;
    *) state=$HOME/.local/state ;;
    esac
    checkout=$(cd "$(dirname "$DEV_SELF")/../../../.." && pwd -P)
    if version=$(cd -P "$state/dev/snapshot/current" 2>/dev/null && pwd -P) &&
        [ -f "$version/main.lua" ] && [ "$(cat "$version/ORIGIN" 2>/dev/null)" = "$checkout" ]; then
        share=$version
        export DEV_CHECKOUT=$checkout
    fi
fi

remote_flag=0
case "${DEV_REMOTE:-}" in
"" | 0 | no | false) ;;
*) remote_flag=1 ;;
esac
for arg in "$@"; do
    case "$arg" in
    --remote | --detach | --priority | --job-timeout) remote_flag=1 ;;
    --) break ;;
    esac
done

if [ -z "$luajit" ]; then
    if [ "$remote_flag" -eq 1 ]; then
        printf '%s\n' "$root_refusal" >&2
        exit 2
    fi
    words=()
    for arg in "$@"; do
        case "$arg" in
        -- | --verbose) continue ;;
        esac
        [[ "$arg" =~ ^-v+$ ]] && continue
        words+=("$arg")
    done
    if [ "${words[0]:-}" = tools ] && { [ "${words[1]:-}" = install ] || [ "${words[1]:-}" = check ]; }; then
        if [ "$(uname)" != Linux ]; then
            printf 'As root, dev runs only on Linux.\n' >&2
            exit 2
        fi
        printf "The command \`dev tools\` needs luajit in /usr/bin or /usr/local/bin.\n" >&2
        exit 1
    fi
    printf '%s\n' "$root_refusal" >&2
    exit 2
fi

if [ "$luajit" = luajit ] && ! command -v luajit >/dev/null 2>&1; then
    if [ "$remote_flag" -eq 1 ]; then
        printf "The flag \`--remote\` needs luajit. Install it with \`brew install luajit\`, \`pacman -S luajit\`, \`dnf install luajit\` or \`apt install luajit\`.\n" >&2
        exit 1
    fi
    printf "Luajit is not found. Install it with \`brew install luajit\`, \`pacman -S luajit\`, \`dnf install luajit\` or \`apt install luajit\`.\n" >&2
    exit 1
fi

exec "$luajit" "$share/main.lua" "$@"
