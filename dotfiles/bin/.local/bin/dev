#!/usr/bin/env bash
# dev: the launcher. It starts luajit on main.lua, which hands every verb to legacy.bash until each is ported.
set -euo pipefail

SYSTEM_BIN_DIRS=(/usr/bin /usr/local/bin)

luajit=luajit
if [ "$EUID" -eq 0 ] || [ "$(id -u)" -eq 0 ]; then
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    unset DEV_UID DEV_OS BASH_ENV ENV
    unset LUA_PATH LUA_CPATH LUA_INIT LUA_PATH_5_1 LUA_CPATH_5_1 LUA_INIT_5_1 LUA_PATH_5_2 LUA_CPATH_5_2 LUA_INIT_5_2
    if [ "${1:-}" = bootstrap ]; then
        printf 'dev: as root, dev runs only tools install and tools check\n' >&2
        exit 2
    fi
    luajit=""
    for dir in "${SYSTEM_BIN_DIRS[@]}"; do
        if [ -x "$dir/luajit" ]; then
            luajit=$dir/luajit
            break
        fi
    done
fi

DEV_SELF=$(realpath "${BASH_SOURCE[0]}")
export DEV_SELF
share=$(cd -P "$(dirname "$DEV_SELF")/../share/dev" && pwd -P)

remote_flag=0
case "${DEV_REMOTE:-}" in
"" | 0 | no | false) ;;
*) remote_flag=1 ;;
esac
for arg in "$@"; do
    case "$arg" in
    --remote | --detach) remote_flag=1 ;;
    --) break ;;
    esac
done

have_luajit=0
if [ -n "$luajit" ] && { [ "$luajit" != luajit ] || command -v luajit >/dev/null 2>&1; }; then
    have_luajit=1
fi

if [ "${1:-}" = bootstrap ]; then
    dev_flag=0
    level=0
    after_dashes=0
    bootstrap_args=()
    for arg in "${@:2}"; do
        if [ "$after_dashes" -eq 1 ]; then
            bootstrap_args+=("$arg")
            continue
        fi
        case "$arg" in
        -h | --help)
            dev_flag=1
            bootstrap_args+=("$arg")
            ;;
        --verbose)
            dev_flag=1
            level=$((level + 1))
            ;;
        --)
            after_dashes=1
            ;;
        *)
            if [[ "$arg" =~ ^-v+$ ]]; then
                dev_flag=1
                level=$((level + ${#arg} - 1))
            else
                bootstrap_args+=("$arg")
            fi
            ;;
        esac
    done
    if [ "$remote_flag" -eq 0 ] && { [ "$have_luajit" -eq 0 ] || [ "$dev_flag" -eq 0 ]; }; then
        if [ "$level" -gt 0 ]; then
            export VERBOSE=$((level > 2 ? 2 : level))
        fi
        if [ -n "${DOTFILES:-}" ]; then
            root=$DOTFILES
        else
            root=$(cd "$(dirname "$DEV_SELF")/../../../.." && pwd)
        fi
        cd "$root"
        exec bash "$root/bootstrap.sh" ${bootstrap_args[@]+"${bootstrap_args[@]}"}
    fi
fi

if [ -z "$luajit" ]; then
    if [ "$remote_flag" -eq 1 ]; then
        printf 'dev: as root, dev runs only tools install and tools check\n' >&2
        exit 2
    fi
    exec bash "$share/legacy.bash" "$@"
fi

if [ "$luajit" = luajit ] && ! command -v luajit >/dev/null 2>&1; then
    if [ "$remote_flag" -eq 1 ]; then
        printf 'dev: --remote needs luajit. Install it with brew install luajit, pacman -S luajit or dnf install luajit\n' >&2
        exit 1
    fi
    printf 'dev: luajit not found. Run dev bootstrap, or install it with brew install luajit, pacman -S luajit or dnf install luajit\n' >&2
    exit 1
fi

exec "$luajit" "$share/main.lua" "$@"
