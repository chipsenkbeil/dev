#!/usr/bin/env bash
# dev: one entry point for lint, fmt, test, build, run, deploy, push and pull.
#
# `dev <verb>` runs `.dev/<verb>.sh` at the repo root when it is executable.
# Otherwise it detects the project type and runs the standard sequence for it.
# Detection order: Cargo.toml (rust), main.lua and conf.lua (love2d),
# project.godot (godot), package.json (node), any .lua file outside dot
# directories (lua), Makefile (make), else none.
#
# `dev help` lists the verbs with descriptions (`.dev/help.sh` replaces it), and
# the hidden `dev __verbs` and `dev __flags <verb>` feed shell completion.
#
# `dev sync` compares a project's copied lint files against the templates in
# the dotfiles repo, unless the project has its own .dev/sync.sh. DOTFILES
# overrides where that repo is found.
set -euo pipefail

VERBS="lint fmt test build run deploy push pull sync init help"
TEMPLATE_BASE="dotfiles/claude/.claude/skills/style/lint"
PROJECT_TYPE=""
PUSH_BACKEND="" PUSH_REF="" PUSH_SHA="" PUSH_GUARD="" PUSH_REMOTES="" PUSH_ERROR=""
PULL_BACKEND="" PULL_SYNC=0 PULL_BRANCH="" PULL_ERROR=""

die() {
    printf 'dev: %s\n' "$*" >&2
    exit 1
}

usage_error() {
    printf 'dev %s: %s\n' "$1" "${*:2}" >&2
    exit 2
}

bad_arg() {
    local kind=argument
    case "$2" in -*) kind=flag ;; esac
    printf 'dev %s: unknown %s %s\n\n' "$1" "$kind" "$2" >&2
    usage >&2
    exit 2
}

no_more_args() {
    [ "$#" -le 1 ] || bad_arg "$1" "$2"
}

# need <binary> <install command>: one WARNING and exit 1 when the binary is missing.
need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'WARNING: %s not found. Install with: %s\n' "$1" "$2" >&2
        exit 1
    fi
}

# verbose_level <value>: 0, 1 or 2 for a VERBOSE value, where empty, no and false are 0 and any other word is 1.
verbose_level() {
    case "$1" in
    "" | no | false) echo 0 ;;
    *[!0-9]*) echo 1 ;;
    *) echo $((10#$1 > 2 ? 2 : 10#$1)) ;;
    esac
}

# show <command...>: print "+ command" on stderr when VERBOSE is 1 or more.
show() {
    if [ "$VERBOSE" -ge 1 ]; then
        printf '+ %s\n' "$*" >&2
    fi
}

# run_cmd <command...>: show the command and run it.
run_cmd() {
    show "$@"
    "$@"
}

# run_script <verb> [args...]: show and exec .dev/<verb>.sh.
run_script() {
    local script="$ROOT/.dev/$1.sh"
    show ".dev/$1.sh" "${@:2}"
    shift
    exec "$script" "$@"
}

# trace_file: the BASH_ENV file that turns on xtrace, beside dev in the stow package.
trace_file() {
    local self
    self=$(realpath "${BASH_SOURCE[0]}")
    printf '%s\n' "$(dirname "$self")/../share/dev/xtrace.bash"
}

has_override() {
    [ -x "$ROOT/.dev/$1.sh" ]
}

repo_root() {
    local root dir
    if command -v jj >/dev/null 2>&1 && root=$(jj root 2>/dev/null); then
        printf '%s\n' "$root"
        return
    fi
    if root=$(git rev-parse --show-toplevel 2>/dev/null); then
        printf '%s\n' "$root"
        return
    fi
    dir=$(pwd -P)
    while [ "$dir" != / ]; do
        if [ -d "$dir/.dev" ]; then
            printf '%s\n' "$dir"
            return
        fi
        dir=$(dirname "$dir")
    done
    pwd -P
}

# vcs_backend: jj when the repo has .jj, git when it has .git, else an error and failure.
vcs_backend() {
    if [ -d "$ROOT/.jj" ]; then
        echo jj
    elif [ -e "$ROOT/.git" ]; then
        echo git
    else
        printf 'dev: neither .jj nor .git found in %s\n' "$ROOT" >&2
        return 1
    fi
}

# --- help ---

# builtin_desc <verb>: the fixed one-line description of a built-in verb.
builtin_desc() {
    case "$1" in
    lint) echo "Check style and formatting for the project type" ;;
    fmt) echo "Format the source for the project type" ;;
    test) echo "Run the project's tests" ;;
    build) echo "Build the project" ;;
    run) echo "Run the project" ;;
    deploy) echo "Deploy the project (needs .dev/deploy.sh)" ;;
    push) echo "Push the trunk bookmark (jj) or the current branch (git) to origin and gerrit, or to the remotes named" ;;
    pull) echo "Fetch the remote and rebase local work onto it" ;;
    sync) echo "Compare copied lint files, the lints block, lib.rs attributes and docs/STYLE.md with the dotfiles templates" ;;
    init) echo "Seed a project with lint, CI and remotes" ;;
    help) echo "Show this table, or the details of one verb" ;;
    esac
}

# script_desc <script>: the first comment line after the shebang, without "# ".
# Shellcheck directives and the flags line do not count.
script_desc() {
    awk '
        NR == 1 { next }
        /^[[:space:]]*$/ { next }
        /^# *shellcheck / { next }
        /^# *flags:/ { next }
        /^#/ { sub(/^# ?/, ""); print; exit }
        { exit }
    ' "$1"
}

# script_header <script>: the comment block after the shebang, without "# ".
script_header() {
    awk '
        NR == 1 { next }
        /^# *shellcheck / { next }
        /^#/ { sub(/^# ?/, ""); print; next }
        { exit }
    ' "$1"
}

# script_flags <script>: the words on the "# flags:" line, one per line.
script_flags() {
    awk '
        /^# *flags:/ { sub(/^# *flags: */, ""); gsub(/,/, " "); n = split($0, w, " ")
            for (i = 1; i <= n; i++) print w[i]; exit }
        /^[^#]/ && NR > 1 { exit }
    ' "$1"
}

# verbs_table: "name<TAB>origin<TAB>description" per visible verb.
verbs_table() {
    local verb script name desc origin
    for verb in $VERBS; do
        origin=builtin
        desc=$(builtin_desc "$verb")
        if has_override "$verb"; then
            origin=override
            script="$ROOT/.dev/$verb.sh"
            desc=$(script_desc "$script")
            : "${desc:=$(builtin_desc "$verb")}"
        fi
        printf '%s\t%s\t%s\n' "$verb" "$origin" "$desc"
    done
    for script in "$ROOT"/.dev/*.sh; do
        [ -x "$script" ] || continue
        name=$(basename "$script" .sh)
        case "$name" in __*) continue ;; esac
        case " $VERBS " in *" $name "*) continue ;; esac
        printf '%s\tlocal\t%s\n' "$name" "$(script_desc "$script")"
    done
}

# verb_flags <verb>: the flags a verb accepts, one per line.
verb_flags() {
    local script="$ROOT/.dev/$1.sh"
    if [ -x "$script" ]; then
        script_flags "$script"
        return
    fi
    case "$1" in
    init) printf '%s\n' --type --public --name --dry-run --no-gerrit ;;
    sync) printf '%s\n' --check --yes -y ;;
    esac
}

# is_verb <name>: true for a built-in or a script in .dev/.
is_verb() {
    case " $VERBS " in *" $1 "*) return 0 ;; esac
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] && has_override "$1"
}

has_make_target() {
    [ -f "$ROOT/Makefile" ] && grep -Eq "^$1[[:space:]]*:" "$ROOT/Makefile"
}

# builtin_commands <verb> <type>: the command lines the built-in runs, one per line.
builtin_commands() {
    local verb=$1 type=$2 remote step
    case "$verb" in
    help)
        echo "dev help [verb]"
        return
        ;;
    init)
        echo "dev init [--type T] [--public] [--name N] [--dry-run] [--no-gerrit]"
        return
        ;;
    deploy)
        echo "(none: add .dev/deploy.sh)"
        return
        ;;
    sync)
        if lint_set_for "$type" >/dev/null; then
            echo "diff the project's lint files against $(dotfiles_root)/$TEMPLATE_BASE/$(lint_set_for "$type")"
        else
            echo "(none: no lint templates for $type projects)"
        fi
        return
        ;;
    push)
        if ! push_resolve; then
            echo "(none: $PUSH_ERROR)"
            return
        fi
        for remote in $PUSH_REMOTES; do
            push_cmd "$remote"
            echo "${PUSH_CMD[*]}"
        done
        return
        ;;
    pull)
        if ! pull_resolve; then
            echo "(none: $PULL_ERROR)"
            return
        fi
        step=1
        while pull_cmd "$step"; do
            echo "${PULL_CMD[*]}"
            step=$((step + 1))
        done
        return
        ;;
    esac
    case "$type:$verb" in
    rust:lint)
        echo "cargo +nightly fmt --check"
        echo "cargo clippy --all-targets --all-features -- -D warnings"
        if [ -f "$ROOT/sgconfig.yml" ]; then echo "ast-grep scan --globs '!target/**'"; fi
        ;;
    rust:fmt) echo "cargo +nightly fmt" ;;
    rust:test)
        echo "cargo nextest run --all-features"
        echo "cargo test --doc --all-features"
        ;;
    rust:build) echo "cargo build --release" ;;
    rust:run) echo "cargo run --" ;;
    love2d:run) echo "love $ROOT" ;;
    love2d:fmt | lua:fmt) echo "stylua $ROOT" ;;
    love2d:test | love2d:lint | lua:* | make:*)
        if has_make_target "$verb"; then
            echo "make -C $ROOT $verb"
        else
            echo "(none: no $verb target in the Makefile)"
        fi
        ;;
    godot:run) echo "godot --path $ROOT" ;;
    node:*)
        if command -v jq >/dev/null 2>&1 &&
            jq -e --arg v "$verb" '.scripts[$v] // empty' "$ROOT/package.json" >/dev/null 2>&1; then
            echo "npm --prefix $ROOT run $verb"
        else
            echo "(none: no $verb script in package.json)"
        fi
        ;;
    *) echo "(none: no built-in $verb for $type projects)" ;;
    esac
}

# set_colors <fd>: color escapes when that descriptor is a terminal, else empty.
set_colors() {
    if [ -t "$1" ] && [ -z "${NO_COLOR:-}" ]; then
        BOLD=$'\033[1m' DIM=$'\033[2m' CYAN=$'\033[36m' RESET=$'\033[0m'
    else
        BOLD="" DIM="" CYAN="" RESET=""
    fi
}

# help_section <title> <rows>: an aligned table of "name<TAB>origin<TAB>description".
# The marker column appears only when a row is an override.
help_section() {
    local title=$1 rows=$2 width=0 name origin desc mark markw=0
    [ -n "$rows" ] || return 0
    while IFS=$'\t' read -r name origin desc; do
        if [ "${#name}" -gt "$width" ]; then width=${#name}; fi
        if [ "$origin" = override ]; then markw=10; fi
    done <<<"$rows"
    printf '\n%s%s%s\n' "$BOLD" "$title" "$RESET"
    while IFS=$'\t' read -r name origin desc; do
        mark=""
        if [ "$origin" = override ]; then mark="(override)"; fi
        printf '  %s%-*s%s  ' "$CYAN" "$width" "$name" "$RESET"
        if [ "$markw" -gt 0 ]; then printf '%s%-*s%s  ' "$DIM" "$markw" "$mark" "$RESET"; fi
        printf '%s\n' "$desc"
    done <<<"$rows"
}

# help_overview <fd>: the project line and the two tables.
help_overview() {
    local rows builtins locals
    set_colors "$1"
    rows=$(verbs_table)
    builtins=$(printf '%s\n' "$rows" | awk -F'\t' '$2 != "local"')
    locals=$(printf '%s\n' "$rows" | awk -F'\t' '$2 == "local"')
    printf '%sdev%s: project %s, root %s\n' "$BOLD" "$RESET" "$(detect_type)" "$ROOT"
    help_section "built-in verbs" "$builtins"
    help_section "local verbs" "$locals"
    help_section "global flags" "-v, --verbose	global	Print each command before it runs, and export VERBOSE=1 to it
-vv	global	Also trace every line of dev and of each bash script it runs, VERBOSE=2"

    # shellcheck disable=SC2016  # the backticks are literal help text
    printf '\nRun `dev help <verb>` for flags, the script header and the command a verb runs.\n'
}

# usage: the overview on stderr, for a bad verb or bad arguments.
usage() {
    help_overview 2
}

help_verb() {
    local verb=$1 script="$ROOT/.dev/$1.sh" row origin desc flags type
    is_verb "$verb" || usage_error help "unknown verb $verb"
    set_colors 1
    row=$(verbs_table | awk -F'\t' -v v="$verb" '$1 == v')
    origin=$(printf '%s\n' "$row" | cut -f2)
    desc=$(printf '%s\n' "$row" | cut -f3)
    printf '%sdev %s%s' "$BOLD" "$verb" "$RESET"
    if [ "$origin" = override ]; then printf ' (override)'; fi
    printf '\n  %s\n' "$desc"
    flags=$(verb_flags "$verb")
    if [ -n "$flags" ]; then
        printf '\n%sflags%s\n' "$BOLD" "$RESET"
        printf '%s\n' "$flags" | sed 's/^/  /'
    fi
    if [ -x "$script" ]; then
        printf '\n%s%s header%s\n' "$BOLD" ".dev/$verb.sh" "$RESET"
        script_header "$script" | sed 's/^/  /'
    fi
    if [ "$origin" != local ]; then
        type=$(detect_type)
        printf '\n%sthe built-in runs%s (%s project)\n' "$BOLD" "$RESET" "$type"
        builtin_commands "$verb" "$type" | sed 's/^/  /'
    fi

    # shellcheck disable=SC2016  # the backticks are literal help text
    printf '\n-v and -vv work anywhere on the line for every verb, see `dev help`.\n'
}

cmd_help() {
    if [ "$#" -gt 0 ]; then
        help_verb "$1"
    else
        help_overview 1
    fi
}

detect_type() {
    if [ -f "$ROOT/Cargo.toml" ]; then
        echo rust
    elif [ -f "$ROOT/main.lua" ] && [ -f "$ROOT/conf.lua" ]; then
        echo love2d
    elif [ -f "$ROOT/project.godot" ]; then
        echo godot
    elif [ -f "$ROOT/package.json" ]; then
        echo node
    elif [ -n "$(find "$ROOT" -mindepth 1 \( -name '.*' -o -name node_modules -o -name target \) -prune -o -type f -name '*.lua' -print -quit)" ]; then
        echo lua
    elif [ -f "$ROOT/Makefile" ]; then
        echo make
    else
        echo none
    fi
}

# lint_set_for <type>: the lint set directory under TEMPLATE_BASE, or failure.
lint_set_for() {
    case "$1" in
    rust) echo rust ;;
    love2d | lua) echo lua ;;
    *) return 1 ;;
    esac
}

unsupported() {
    printf 'dev: no built-in %s for %s projects, add .dev/%s.sh\n' "$1" "$2" "$1" >&2
    exit 1
}

# make_target <target> [args...]: run the Makefile target when it exists.
make_target() {
    local target=$1
    if [ -f "$ROOT/Makefile" ] && grep -Eq "^${target}[[:space:]]*:" "$ROOT/Makefile"; then
        need make "xcode-select --install"
        run_cmd make -C "$ROOT" "$@"
    else
        return 1
    fi
}

builtin_rust() {
    local verb=$1
    shift
    need cargo "brew install rustup"
    case "$verb" in
    lint)
        if ! cargo +nightly fmt --version >/dev/null 2>&1; then
            printf 'WARNING: nightly rustfmt not found. Install with: rustup toolchain install nightly --component rustfmt\n' >&2
            exit 1
        fi
        run_cmd cargo +nightly fmt --check
        run_cmd cargo clippy --all-targets --all-features -- -D warnings
        if [ -f "$ROOT/sgconfig.yml" ]; then
            need ast-grep "brew install ast-grep"
            (cd "$ROOT" && run_cmd ast-grep scan --globs '!target/**')
        fi
        ;;
    fmt)
        run_cmd cargo +nightly fmt "$@"
        ;;
    test)
        if ! cargo nextest --version >/dev/null 2>&1; then
            printf 'WARNING: cargo-nextest not found. Install with: cargo install cargo-nextest --locked\n' >&2
            exit 1
        fi
        run_cmd cargo nextest run --all-features "$@"
        run_cmd cargo test --doc --all-features "$@"
        ;;
    build)
        run_cmd cargo build --release "$@"
        ;;
    run)
        run_cmd cargo run -- "$@"
        ;;
    *) unsupported "$verb" rust ;;
    esac
}

builtin_love2d() {
    local verb=$1
    shift
    case "$verb" in
    run)
        need love "brew install --cask love"
        run_cmd love "$ROOT" "$@"
        ;;
    test | lint)
        make_target "$verb" "$@" || unsupported "$verb" love2d
        ;;
    fmt)
        need stylua "brew install stylua"
        run_cmd stylua "$@" "$ROOT"
        ;;
    *) unsupported "$verb" love2d ;;
    esac
}

builtin_lua() {
    local verb=$1
    shift
    case "$verb" in
    fmt)
        need stylua "brew install stylua"
        run_cmd stylua "$@" "$ROOT"
        ;;
    *)
        make_target "$verb" "$@" || unsupported "$verb" lua
        ;;
    esac
}

builtin_godot() {
    local verb=$1
    shift
    case "$verb" in
    run)
        need godot "brew install --cask godot"
        run_cmd godot --path "$ROOT" "$@"
        ;;
    *) unsupported "$verb" godot ;;
    esac
}

builtin_node() {
    local verb=$1
    shift
    need jq "brew install jq"
    if ! jq -e --arg v "$verb" '.scripts[$v] // empty' "$ROOT/package.json" >/dev/null 2>&1; then
        unsupported "$verb" node
    fi
    need npm "brew install node"
    if [ "$#" -gt 0 ]; then
        run_cmd npm --prefix "$ROOT" run "$verb" -- "$@"
    else
        run_cmd npm --prefix "$ROOT" run "$verb"
    fi
}

builtin_make() {
    local verb=$1
    shift
    make_target "$verb" "$@" || unsupported "$verb" make
}

# trunk_name <bookmark list>: master or main, whichever the list holds.
trunk_name() {
    local name
    for name in master main; do
        if printf '%s\n' "$1" | grep -Fxq "$name"; then
            echo "$name"
            return
        fi
    done
    return 1
}

# push_resolve: set PUSH_BACKEND, PUSH_REF, PUSH_SHA, PUSH_GUARD and PUSH_REMOTES, or set PUSH_ERROR and fail.
push_resolve() {
    local remotes remote
    PUSH_BACKEND=$(vcs_backend 2>/dev/null) || {
        PUSH_ERROR="neither .jj nor .git found in $ROOT"
        return 1
    }
    if [ "$PUSH_BACKEND" = jj ]; then
        if ! command -v jj >/dev/null 2>&1; then
            PUSH_ERROR="jj not found, install with: brew install jj"
            return 1
        fi
        PUSH_REF=$(trunk_name "$(jj --no-pager --color never -R "$ROOT" bookmark list -T 'name ++ "\n"')") || {
            PUSH_ERROR="no master or main bookmark in $ROOT"
            return 1
        }
    else
        PUSH_REF=$(git -C "$ROOT" symbolic-ref --short -q HEAD) || {
            PUSH_ERROR="HEAD is detached in $ROOT, check out a branch to push"
            return 1
        }
        PUSH_SHA=$(git -C "$ROOT" rev-parse HEAD)
        PUSH_GUARD="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/commit-guard"
        if [ ! -x "$PUSH_GUARD" ]; then
            PUSH_ERROR="commit-guard is missing at $PUSH_GUARD, refusing to push without the attribution check"
            return 1
        fi
    fi
    remotes=$(remote_names)
    PUSH_REMOTES=""
    for remote in origin gerrit; do
        if printf '%s\n' "$remotes" | grep -Fxq "$remote"; then
            PUSH_REMOTES+="$remote "
        fi
    done
    if [ -z "$PUSH_REMOTES" ]; then
        PUSH_ERROR="no origin or gerrit remote"
        return 1
    fi
}

# push_cmd <remote>: set PUSH_CMD to the command that pushes to that remote, after push_resolve.
push_cmd() {
    if [ "$PUSH_BACKEND" = jj ]; then
        PUSH_CMD=(jj --no-pager --color never -R "$ROOT" git push --remote "$1" -b "$PUSH_REF")
    else
        PUSH_CMD=("$PUSH_GUARD" push -- "$1" "$PUSH_SHA:refs/heads/$PUSH_REF")
    fi
}

cmd_push() {
    local remote out rc status=0 remotes
    for remote in "$@"; do
        case "$remote" in -*) bad_arg push "$remote" ;; esac
    done
    push_resolve || die "$PUSH_ERROR"
    remotes=$PUSH_REMOTES
    if [ "$#" -gt 0 ]; then
        remotes=""
        for remote in "$@"; do
            case " $PUSH_REMOTES" in
            *" $remote "*) remotes+="$remote " ;;
            *) usage_error push "no remote $remote to push to, the project has: $PUSH_REMOTES" ;;
            esac
        done
    fi
    for remote in $remotes; do
        push_cmd "$remote"
        show "${PUSH_CMD[@]}"
        out=$(cd "$ROOT" && "${PUSH_CMD[@]}" 2>&1) && rc=0 || rc=$?
        if [ "$rc" -eq 0 ]; then
            printf '%s: pushed %s\n' "$remote" "$PUSH_REF"
        else
            printf '%s: push of %s failed\n' "$remote" "$PUSH_REF"
            status=1
        fi
        if [ -n "$out" ]; then
            printf '%s\n' "$out" | sed 's/^/    /'
        fi
    done
    return "$status"
}

# pull_resolve: set PULL_BACKEND, PULL_SYNC and PULL_BRANCH, or set PULL_ERROR and fail.
pull_resolve() {
    PULL_BACKEND=$(vcs_backend 2>/dev/null) || {
        PULL_ERROR="neither .jj nor .git found in $ROOT"
        return 1
    }
    if [ "$PULL_BACKEND" = jj ]; then
        if ! command -v jj >/dev/null 2>&1; then
            PULL_ERROR="jj not found, install with: brew install jj"
            return 1
        fi
        PULL_SYNC=0
        if jj --no-pager -R "$ROOT" config get aliases.sync >/dev/null 2>&1; then
            PULL_SYNC=1
        fi
        return 0
    fi
    PULL_BRANCH=$(git -C "$ROOT" symbolic-ref --short -q HEAD) || {
        PULL_ERROR="HEAD is detached in $ROOT, check out a branch to pull"
        return 1
    }
    if [ -n "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]; then
        PULL_ERROR="$ROOT has uncommitted changes, commit or stash them before pulling"
        return 1
    fi
}

# pull_cmd <step>: set PULL_CMD to that step of the pull, after pull_resolve, or fail past the last step.
pull_cmd() {
    case "$PULL_BACKEND:$PULL_SYNC:$1" in
    jj:1:1) PULL_CMD=(jj --no-pager -R "$ROOT" sync) ;;
    jj:0:1) PULL_CMD=(jj --no-pager -R "$ROOT" git fetch --all-remotes) ;;
    jj:0:2) PULL_CMD=(jj --no-pager -R "$ROOT" rebase -o 'trunk()' --skip-emptied) ;;
    git:*:1) PULL_CMD=(git -C "$ROOT" pull --rebase origin "$PULL_BRANCH") ;;
    *) return 1 ;;
    esac
}

cmd_pull() {
    local step=1
    no_more_args pull "$@"
    pull_resolve || die "$PULL_ERROR"
    while pull_cmd "$step"; do
        run_cmd "${PULL_CMD[@]}"
        step=$((step + 1))
    done
}

# --- templates ---

dotfiles_root() {
    local self
    if [ -n "${DOTFILES:-}" ]; then
        printf '%s\n' "$DOTFILES"
    else
        self=$(realpath "${BASH_SOURCE[0]}")

        # <dotfiles>/dotfiles/bin/.local/bin/dev, four levels below the repo.
        (cd "$(dirname "$self")/../../../.." && pwd)
    fi
}

# templates_dir <type>: the lint set directory for a project type.
templates_dir() {
    local repo set
    repo=$(dotfiles_root)
    set=$(lint_set_for "$1") || die "no lint templates for $1 projects"
    if [ ! -d "$repo/$TEMPLATE_BASE/$set" ]; then
        die "no lint templates at $repo/$TEMPLATE_BASE/$set (set DOTFILES to the dotfiles repo)"
    fi
    printf '%s\n' "$repo/$TEMPLATE_BASE/$set"
}

stable_channel() {
    local version
    version=$(rustc +stable --version 2>/dev/null || rustc --version 2>/dev/null) || return 1
    version=${version#rustc }
    printf '%s\n' "${version%% *}"
}

# The channel a project already pins wins, so a sync never moves the pin.
channel_for_project() {
    local line
    if [ -f "$ROOT/rust-toolchain.toml" ]; then
        line=$(grep -E '^channel[[:space:]]*=' "$ROOT/rust-toolchain.toml" | head -n1 || true)
        if [ -n "$line" ]; then
            line=${line#*=}
            line=${line//[ \"]/}
            printf '%s\n' "$line"
            return
        fi
    fi
    stable_channel || echo stable
}

# manifest <template dir>: lines of "project path<TAB>template path". The set is
# named by the template directory, and the Lua set ships love.yml to love2d only.
manifest() {
    local t=$1 f roots scripts rules
    rules=$(cd "$t/ast-grep" && find rules rule-test -type f | sort)
    case "$(basename "$t")" in
    rust)
        roots="rustfmt.toml rust-toolchain.toml clippy.toml deny.toml"
        scripts="lint.sh fmt.sh test.sh"
        ;;
    lua)
        roots="stylua.toml selene.toml luajit.yml"
        if [ "$PROJECT_TYPE" = love2d ]; then roots+=" love.yml"; fi
        scripts="lint.sh fmt.sh"
        ;;
    esac
    for f in $roots; do
        printf '%s\t%s\n' "$f" "$t/$f"
    done
    printf 'sgconfig.yml\t%s\n' "$t/ast-grep/sgconfig.yml"
    for f in $scripts; do
        printf '.dev/%s\t%s\n' "$f" "$t/$f"
    done
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        printf '.dev/ast-grep/%s\t%s\n' "$f" "$t/ast-grep/$f"
    done <<<"$rules"
}

# lint_project_tail: the project's own checks below the marker in .dev/lint.sh, with
# a leading newline, so a rendered template keeps them and sync never reports them.
lint_project_tail() {
    local marker='# --- project-specific checks below ---' tail
    [ -f "$ROOT/.dev/lint.sh" ] || return 0
    tail=$(sed -n "/^${marker}\$/,\$p" "$ROOT/.dev/lint.sh" | sed '1d')
    [ -n "$tail" ] && printf '\n%s' "$tail"
    return 0
}

# render <project path> <template path> <channel>: the project copy of a template.
render() {
    local dest=$1 src=$2 channel=$3 content cd_old cd_new sg_old sg_new
    sg_old='--config ast-grep/sgconfig.yml'
    sg_new='--config sgconfig.yml'

    # shellcheck disable=SC2016  # the template line is matched literally, not expanded
    cd_old='cd "$(dirname "${BASH_SOURCE[0]}")"'

    # shellcheck disable=SC2016  # the replacement line is written literally, not expanded
    cd_new='cd "$(dirname "${BASH_SOURCE[0]}")/.."'
    content=$(<"$src")
    case "$dest" in
    sgconfig.yml)
        content=${content/"  - rules"/"  - .dev/ast-grep/rules"}
        content=${content/"testDir: rule-test"/"testDir: .dev/ast-grep/rule-test"}
        ;;
    .dev/lint.sh)
        content=${content/"$cd_old"/"$cd_new"}
        content=${content//"$sg_old"/"$sg_new"}
        content+=$(lint_project_tail)
        ;;
    .dev/fmt.sh | .dev/test.sh)
        content=${content/"$cd_old"/"$cd_new"}
        ;;
    rust-toolchain.toml)
        content=$(printf '%s\n' "$content" | sed "s/^channel = .*/channel = \"$channel\"/")
        ;;
    selene.toml)
        if [ "$PROJECT_TYPE" = lua ]; then
            content=${content/'std = "love"'/'std = "luajit"'}
        fi
        ;;
    esac
    printf '%s\n' "$content"
}

# install_rendered <project path> <template path> <channel>
install_rendered() {
    local content
    mkdir -p "$(dirname "$ROOT/$1")"
    content=$(render "$1" "$2" "$3")
    printf '%s\n' "$content" >"$ROOT/$1"
    case "$1" in *.sh) chmod +x "$ROOT/$1" ;; esac
}

# lints_template_block <template dir>: the workspace lints without the paste header.
lints_template_block() {
    local block
    block=$(<"$1/workspace-lints.toml")
    printf '%s\n' "${block#*$'\n\n'}"
}

# lints_project_block: the [workspace.lints*] tables of the project Cargo.toml, from the
# first such line to the next other top-level table or the end, without trailing blanks.
lints_project_block() {
    local block
    [ -f "$ROOT/Cargo.toml" ] || return 0
    block=$(awk '
        done { next }
        /^\[/ { if ($0 ~ /^\[workspace\.lints/) { on = 1 } else if (on) { done = 1; next } }
        on { print }
    ' "$ROOT/Cargo.toml")
    [ -n "$block" ] && printf '%s\n' "$block"
    return 0
}

# lints_replace <block file>: swap the project block for the file, or append it.
lints_replace() {
    local out
    out=$(mktemp)
    if grep -q '^\[workspace\.lints' "$ROOT/Cargo.toml"; then
        awk -v blockfile="$1" '
            function emit(   l) { while ((getline l < blockfile) > 0) print l; close(blockfile) }
            done { print; next }
            /^\[/ {
                if ($0 ~ /^\[workspace\.lints/) { if (!on) { emit(); on = 1 } next }
                if (on) { on = 0; done = 1; print ""; print; next }
            }
            on { next }
            { print }
        ' "$ROOT/Cargo.toml" >"$out"
    else
        {
            cat "$ROOT/Cargo.toml"
            printf '\n'
            cat "$1"
        } >"$out"
    fi
    cat "$out" >"$ROOT/Cargo.toml"
    rm -f "$out"
}

# crate_dirs: the member crate directories (relative to the root), one per line.
crate_dirs() {
    local m d
    [ -f "$ROOT/Cargo.toml" ] || return 0
    if [ "$(yq -p toml -oy '.package.name' "$ROOT/Cargo.toml" 2>/dev/null)" != null ]; then
        echo .
    fi
    while IFS= read -r m; do
        [ -n "$m" ] && [ "$m" != null ] || continue
        for d in "$ROOT"/$m; do
            if [ -f "$d/Cargo.toml" ]; then
                d=${d#"$ROOT"/}
                echo "$d"
            fi
        done
    done < <(yq -p toml -oy '.workspace.members[]' "$ROOT/Cargo.toml" 2>/dev/null)
}

# crate_is_app <dir>: succeeds for a crate with publish = false.
crate_is_app() {
    grep -Eq '^publish[[:space:]]*=[[:space:]]*false' "$ROOT/$1/Cargo.toml"
}

# lib_crates: crate directories in library register that have a src/lib.rs.
lib_crates() {
    local d
    while IFS= read -r d; do
        [ -f "$ROOT/$d/src/lib.rs" ] || continue
        crate_is_app "$d" || echo "$d"
    done < <(crate_dirs)
}

# app_crates: crate directories with publish = false.
app_crates() {
    local d
    while IFS= read -r d; do
        ! crate_is_app "$d" || echo "$d"
    done < <(crate_dirs)
}

# lib_attr_line <template dir>: the attribute line of the lib-lints snippet.
lib_attr_line() {
    tail -n 1 "$1/lib-lints.rs.snippet"
}

# lib_attr_present <template dir> <crate dir>
lib_attr_present() {
    grep -Fxq "$(lib_attr_line "$1")" "$ROOT/$2/src/lib.rs"
}

# lib_attr_insert <template dir> <crate dir>: put the snippet after the leading //! block.
lib_attr_insert() {
    local file="$ROOT/$2/src/lib.rs" out
    out=$(mktemp)
    awk -v snip="$1/lib-lints.rs.snippet" '
        { lines[NR] = $0 }
        END {
            n = 0
            while (n < NR && lines[n + 1] ~ /^\/\/!/) n++
            for (i = 1; i <= n; i++) print lines[i]
            if (n > 0) print ""
            while ((getline s < snip) > 0) print s
            if (n < NR && lines[n + 1] != "") print ""
            for (i = n + 1; i <= NR; i++) print lines[i]
        }
    ' "$file" >"$out"
    cat "$out" >"$file"
    rm -f "$out"
}

cmd_sync() {
    local check=0 yes=0 t type channel dest src tmp rc=0 drifted=0 answer lib missing_libs="" guide style_drift=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
        --check) check=1 ;;
        -y | --yes) yes=1 ;;
        *) bad_arg sync "$1" ;;
        esac
        shift
    done
    if [ "$check" -eq 1 ] && [ "$yes" -eq 1 ]; then
        printf 'dev: sync takes --check or --yes, not both\n\n' >&2
        usage >&2
        exit 2
    fi
    type=$(detect_type)
    if ! lint_set_for "$type" >/dev/null; then
        echo "dev: no lint templates for $type projects"
        return 0
    fi
    PROJECT_TYPE=$type
    t=$(templates_dir "$type")
    if [ -f "$ROOT/Cargo.toml" ]; then
        need yq "brew install yq"
    fi
    channel=$(channel_for_project)
    SYNC_TMP=$(mktemp -d)
    tmp=$SYNC_TMP
    trap 'rm -rf "$SYNC_TMP"' EXIT

    while IFS=$'\t' read -r dest src; do
        mkdir -p "$(dirname "$tmp/$dest")"
        render "$dest" "$src" "$channel" >"$tmp/$dest"
        if [ ! -f "$ROOT/$dest" ]; then
            printf 'missing: %s\n' "$dest"
            drifted=1
        elif ! diff -q "$ROOT/$dest" "$tmp/$dest" >/dev/null; then
            printf 'differs: %s\n' "$dest"
            drifted=1
        fi
    done < <(manifest "$t")

    if [ -f "$ROOT/Cargo.toml" ]; then
        lints_template_block "$t" >"$tmp/lints.new"
        lints_project_block >"$tmp/lints.old"
        if [ ! -s "$tmp/lints.old" ]; then
            printf 'missing: [workspace.lints] block in Cargo.toml\n'
            drifted=1
        elif ! diff -q "$tmp/lints.old" "$tmp/lints.new" >/dev/null; then
            printf 'differs: [workspace.lints] block in Cargo.toml\n'
            drifted=1
        fi
    fi
    while IFS= read -r lib; do
        if ! lib_attr_present "$t" "$lib"; then
            printf 'missing: library-register attribute in %s/src/lib.rs\n' "$lib"
            missing_libs+="$lib"$'\n'
            drifted=1
        fi
    done < <(lib_crates)
    if [ -f "$ROOT/docs/STYLE.md" ] && grep -qx "$STYLE_MARKER" "$ROOT/docs/STYLE.md" &&
        guide=$(style_guide_for "$type") && [ -f "$guide" ]; then
        render_style "$guide" >"$tmp/STYLE.md"
        if ! diff -q "$ROOT/docs/STYLE.md" "$tmp/STYLE.md" >/dev/null; then
            printf 'differs: docs/STYLE.md above "%s"\n' "$STYLE_MARKER"
            style_drift=1
            drifted=1
        fi
    fi

    if [ "$drifted" -eq 0 ]; then
        echo "up to date"
        return 0
    fi
    if [ "$check" -eq 1 ]; then
        return 1
    fi
    if [ "$yes" -eq 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
        die "sync overwrites files and needs a terminal to confirm, pass --yes to apply without asking, or --check to list drift"
    fi
    while IFS=$'\t' read -r dest src; do
        if [ ! -f "$ROOT/$dest" ]; then
            diff -u /dev/null "$tmp/$dest" || true
        else
            diff -u "$ROOT/$dest" "$tmp/$dest" || true
        fi
    done < <(manifest "$t")
    if [ -f "$ROOT/Cargo.toml" ] && ! diff -q "$tmp/lints.old" "$tmp/lints.new" >/dev/null; then
        diff -u "$tmp/lints.old" "$tmp/lints.new" || true
    fi
    while IFS= read -r lib; do
        [ -n "$lib" ] && printf 'would insert into %s/src/lib.rs:\n%s\n' "$lib" "$(<"$t/lib-lints.rs.snippet")"
    done <<<"$missing_libs"
    [ "$style_drift" -eq 0 ] || diff -u "$ROOT/docs/STYLE.md" "$tmp/STYLE.md" || true
    if [ "$yes" -eq 1 ]; then
        answer=y
    else
        printf 'Overwrite these files, the lints block, the lib.rs attributes and the guide part of docs/STYLE.md with the templates? [y/N] '
        read -r answer
    fi
    case "$answer" in
    y | Y | yes)
        while IFS=$'\t' read -r dest src; do
            install_rendered "$dest" "$src" "$channel" || rc=1
        done < <(manifest "$t")
        if [ -f "$ROOT/Cargo.toml" ] && ! diff -q "$tmp/lints.old" "$tmp/lints.new" >/dev/null; then
            lints_replace "$tmp/lints.new" || rc=1
        fi
        while IFS= read -r lib; do
            [ -z "$lib" ] || lib_attr_insert "$t" "$lib" || rc=1
        done <<<"$missing_libs"
        [ "$style_drift" -eq 0 ] || cat "$tmp/STYLE.md" >"$ROOT/docs/STYLE.md" || rc=1
        echo "synced"
        ;;
    *) echo "aborted" ;;
    esac
    return "$rc"
}

# --- init ---

CREATED=""
SKIPPED=""
HUMAN=""
DRY=0

created() {
    CREATED+="$1"$'\n'
    if [ "$DRY" -eq 1 ]; then
        printf 'would create: %s\n' "$1"
    else
        printf 'created: %s\n' "$1"
    fi
}

skipped() {
    SKIPPED+="$1"$'\n'
    printf 'skipped: %s\n' "$1"
}

human() {
    HUMAN+="$1"$'\n'
}

# remote_names: the remotes the project already has, one per line.
remote_names() {
    local backend
    backend=$(vcs_backend 2>/dev/null) || return 0
    if [ "$backend" = jj ]; then
        need jj "brew install jj"
        jj --no-pager --color never -R "$ROOT" git remote list | awk '{print $1}'
    else
        git -C "$ROOT" remote
    fi
}

# remote_add_hint <backend>: the command a person runs to add a remote with that backend.
remote_add_hint() {
    if [ "$1" = jj ]; then
        echo "jj git remote add"
    else
        echo "git remote add"
    fi
}

# init_trunk: the trunk branch name for a project, master when nothing says otherwise.
init_trunk() {
    local names="" backend
    backend=$(vcs_backend 2>/dev/null) || backend=""
    if [ "$backend" = jj ]; then
        names=$(jj --no-pager --color never -R "$ROOT" bookmark list -T 'name ++ "\n"' 2>/dev/null || true)
    elif [ "$backend" = git ]; then
        names=$(git -C "$ROOT" for-each-ref --format='%(refname:short)' refs/heads)
    fi
    trunk_name "$names" 2>/dev/null ||
        git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null ||
        echo master
}

# put_template <project path> <template path> <channel>
put_template() {
    if [ -e "$ROOT/$1" ]; then
        skipped "$1 exists"
        return
    fi
    if [ "$DRY" -eq 0 ]; then
        install_rendered "$1" "$2" "$3"
    fi
    created "$1"
}

# put_generated <project path> <generator function> [generator args...]
put_generated() {
    local dest=$1
    shift
    if [ -e "$ROOT/$dest" ]; then
        skipped "$dest exists"
        return
    fi
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$(dirname "$ROOT/$dest")"
        "$@" >"$ROOT/$dest"
    fi
    created "$dest"
}

STYLE_MARKER='## This project'

# style_guide_for <type>: the dotfiles guide a project of this type copies into docs/STYLE.md.
style_guide_for() {
    case "$1" in
    rust) printf '%s\n' "$(dotfiles_root)/docs/style/rust.md" ;;
    love2d | lua) printf '%s\n' "$(dotfiles_root)/docs/style/lua.md" ;;
    *) return 1 ;;
    esac
}

# render_style <guide>: the guide followed by the project's own section of docs/STYLE.md.
render_style() {
    cat "$1"
    printf '\n'
    sed -n "/^${STYLE_MARKER}\$/,\$p" "$ROOT/docs/STYLE.md"
}

# put_style_guide <language>: seed docs/STYLE.md from the dotfiles repo's guide.
put_style_guide() {
    local guide
    guide="$(dotfiles_root)/docs/style/$1.md"
    if [ -e "$ROOT/docs/STYLE.md" ]; then
        skipped "docs/STYLE.md exists"
        return
    fi
    if [ ! -f "$guide" ]; then
        skipped "docs/STYLE.md: no $1 guide at $guide"
        return
    fi
    if [ "$DRY" -eq 0 ]; then
        mkdir -p "$ROOT/docs"
        {
            cat "$guide"
            printf '\n%s\n\nRules that apply only to this project go here. Number them P1, P2, and so on. The numbers above only grow, so a project rule never shares a number with a guide rule.\n' "$STYLE_MARKER"
        } >"$ROOT/docs/STYLE.md"
    fi
    created "docs/STYLE.md"
}

# emit_pipeline <type> <toolchain>
emit_pipeline() {
    local body
    if [ "$1" = rust ]; then
        read -r -d '' body <<'LUA' || true
-- Check the project on a linux container with .dev/lint.sh, then .dev/test.sh
--
--   ci run --local

-- Install the project's pinned channel, which the runner image usually bakes in
local TOOLCHAIN = "@TOOLCHAIN@"

-- Prefix cargo's directory on every command, since each ci.sh gets a fresh shell
local function run(command)
  return ci.sh("export PATH=$HOME/.cargo/bin:$PATH; " .. command)
end

local function install_rust()
  ci.group("install rust " .. TOOLCHAIN, function()
    run("rustup toolchain install " .. TOOLCHAIN .. " --component clippy,rustfmt")
    run("rustup toolchain install nightly --profile minimal --component rustfmt")
    run("command -v cargo-nextest >/dev/null || { mkdir -p $HOME/.cargo/bin && curl -LsSf https://get.nexte.st/latest/linux | tar zxf - -C $HOME/.cargo/bin; }")
  end)
end

return {
  jobs = {
    check = {
      matrix = { { os = "linux-ct", image = "rust-runner-ct" } },
      run = function()
        install_rust()
        run(".dev/lint.sh")
        run(".dev/test.sh")
      end,
    },
  },
}
LUA
    else
        read -r -d '' body <<'LUA' || true
-- Check the project on a linux container with .dev/lint.sh and .dev/test.sh when present
--
--   ci run --local

return {
  jobs = {
    check = {
      matrix = { { os = "linux-ct" } },
      run = function()
        ci.sh("if [ -x .dev/lint.sh ]; then .dev/lint.sh; fi")
        ci.sh("if [ -x .dev/test.sh ]; then .dev/test.sh; fi")
      end,
    },
  },
}
LUA
    fi
    printf '%s\n' "${body/@TOOLCHAIN@/$2}"
}

# emit_workflow <trunk>
emit_workflow() {
    local body
    read -r -d '' body <<'YAML' || true
name: ci

on:
  pull_request:
  push:
    branches: [@TRUNK@]
    tags: ["*"]

jobs:
  check:
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    steps:
      - uses: actions/checkout@v4
      - name: Install nightly rustfmt
        run: rustup toolchain install nightly --profile minimal --component rustfmt
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-nextest
      - name: Lint
        run: .dev/lint.sh
        shell: bash
      - name: Test
        run: .dev/test.sh
        shell: bash
YAML
    printf '%s\n' "${body/@TRUNK@/$1}"
}

# init_lint_files <template dir> <channel>: every file of the manifest that is not there yet.
init_lint_files() {
    local t=$1 channel=$2 dest src
    while IFS=$'\t' read -r dest src; do
        put_template "$dest" "$src" "$channel"
    done < <(manifest "$t")
}

# init_workspace_lints <template dir>: the [workspace.lints] block of a rust project.
init_workspace_lints() {
    local t=$1 block
    if [ ! -f "$ROOT/Cargo.toml" ]; then
        skipped "workspace lints: no Cargo.toml"
        return
    fi
    if grep -q '^\[workspace\.lints' "$ROOT/Cargo.toml"; then
        skipped "workspace lints in Cargo.toml exist"
        return
    fi
    if [ "$DRY" -eq 0 ]; then
        block=$(<"$t/workspace-lints.toml")

        # Drop the template's leading comment header, which ends at the first blank line.
        block=${block#*$'\n\n'}
        printf '\n%s\n' "$block" >>"$ROOT/Cargo.toml"

        # cargo-sort wants [workspace.*] tables ahead of [dependencies].
        if command -v cargo-sort >/dev/null 2>&1; then
            show cargo sort --workspace
            (cd "$ROOT" && cargo sort --workspace >/dev/null 2>&1) || true
        fi
    fi
    created "[workspace.lints] block in Cargo.toml"
    human 'add "[lints]" with "workspace = true" to each member crate Cargo.toml'
    printf 'reminder: each member crate needs [lints] with workspace = true\n'
    printf 'note: the lints deny warnings, so fix every finding in the same change that adds this block\n'
}

# init_lib_attrs <template dir>: the library-register attribute in each library crate.
init_lib_attrs() {
    local t=$1 d
    while IFS= read -r d; do
        if lib_attr_present "$t" "$d"; then
            skipped "$d/src/lib.rs has the library-register attribute"
            continue
        fi
        if [ "$DRY" -eq 0 ]; then
            lib_attr_insert "$t" "$d"
        fi
        created "$d/src/lib.rs library-register attribute"
    done < <(lib_crates)
    while IFS= read -r d; do
        printf 'application register, no doc lints: %s\n' "$d"
    done < <(app_crates)
}

init_gerrit() {
    local name=$1 backend=$2 projects
    if [ "$DRY" -eq 1 ]; then
        created "gerrit project $name (create-project when absent) and remote gerrit gr:$name"
        return
    fi
    show ssh -p 29418 user@gerrit.example.com gerrit ls-projects
    if ! projects=$(ssh -p 29418 user@gerrit.example.com gerrit ls-projects 2>&1); then
        printf 'warning: gerrit ls-projects failed: %s\n' "$projects" >&2
        human "create the Gerrit project and remote: ssh -p 29418 user@gerrit.example.com gerrit create-project $name, then $(remote_add_hint "$backend") gerrit gr:$name"
        return
    fi
    if printf '%s\n' "$projects" | grep -Fxq "$name"; then
        skipped "gerrit project $name exists"
    elif run_cmd ssh -p 29418 user@gerrit.example.com gerrit create-project "$name"; then
        created "gerrit project $name"
    else
        human "create the Gerrit project: ssh -p 29418 user@gerrit.example.com gerrit create-project $name"
        return
    fi
    if [ "$backend" = jj ]; then
        run_cmd jj --no-pager -R "$ROOT" git remote add gerrit "gr:$name"
    else
        run_cmd git -C "$ROOT" remote add gerrit "gr:$name"
    fi
    created "remote gerrit gr:$name"
}

cmd_init() {
    local type="" name="" public=0 gerrit=1 remotes t channel trunk backend
    while [ "$#" -gt 0 ]; do
        case "$1" in
        --type)
            [ "$#" -ge 2 ] || usage_error init "--type needs a value"
            type=$2
            shift 2
            ;;
        --name)
            [ "$#" -ge 2 ] || usage_error init "--name needs a value"
            name=$2
            shift 2
            ;;
        --public)
            public=1
            shift
            ;;
        --dry-run)
            DRY=1
            shift
            ;;
        --no-gerrit)
            gerrit=0
            shift
            ;;
        *) bad_arg init "$1" ;;
        esac
    done
    case "$type" in
    "") type=$(detect_type) ;;
    rust | love2d | lua | godot | node) ;;
    *) usage_error init "--type takes rust, love2d, lua, godot or node" ;;
    esac
    if [ "$type" = rust ] && [ -f "$ROOT/Cargo.toml" ]; then
        need yq "brew install yq"
    fi
    PROJECT_TYPE=$type
    : "${name:=$(basename "$ROOT")}"
    printf 'init %s: type %s, public %s, dry run %s\n' "$name" "$type" "$public" "$DRY"

    # VCS
    if [ -d "$ROOT/.jj" ]; then
        backend=jj
        skipped ".jj exists"
    elif [ -f "$ROOT/.git" ]; then
        backend=git
        skipped ".jj: this is a git worktree, colocate jj in the main checkout"
    else
        if [ -e "$ROOT/.git" ]; then
            skipped ".git exists"
        else
            if [ "$DRY" -eq 0 ]; then
                run_cmd git -C "$ROOT" init -q
            fi
            created ".git (git init)"
        fi
        if command -v jj >/dev/null 2>&1; then
            backend=jj
            if [ "$DRY" -eq 0 ]; then
                show jj git init --colocate
                (cd "$ROOT" && jj git init --colocate >/dev/null 2>&1)
            fi
            created ".jj (jj git init --colocate)"
        else
            backend=git
            skipped ".jj (jj not installed, git only)"
        fi
    fi

    # Lint set
    case "$type" in
    rust)
        t=$(templates_dir rust)
        channel=$(channel_for_project)
        init_lint_files "$t" "$channel"
        init_workspace_lints "$t"
        init_lib_attrs "$t"
        ;;
    love2d | lua)
        t=$(templates_dir "$type")
        init_lint_files "$t" ""
        ;;
    *)
        skipped "lint set: none yet for $type projects"
        ;;
    esac

    # Style guide
    case "$type" in
    rust) put_style_guide rust ;;
    love2d | lua) put_style_guide lua ;;
    *) skipped "docs/STYLE.md: no style guide for $type projects" ;;
    esac

    # CI pipeline
    channel=$(channel_for_project)
    put_generated .ci/pipeline.lua emit_pipeline "$type" "$channel"

    # GitHub workflow
    if [ "$public" -eq 1 ]; then
        if [ "$type" = rust ]; then
            trunk=$(init_trunk)
            put_generated .github/workflows/ci.yml emit_workflow "$trunk"
        else
            skipped ".github/workflows/ci.yml: no workflow for $type projects"
        fi
    else
        skipped ".github/workflows/ci.yml: project is not public"
    fi

    # Remotes
    remotes=$(remote_names)
    if printf '%s\n' "$remotes" | grep -Fxq origin; then
        skipped "remote origin exists"
    else
        printf 'remote origin is missing, create the GitHub repo and run: %s origin hub:%s\n' "$(remote_add_hint "$backend")" "$name"
        human "create the GitHub repo, then run: $(remote_add_hint "$backend") origin hub:$name"
    fi
    if [ "$gerrit" -eq 0 ]; then
        skipped "gerrit: --no-gerrit"
    elif printf '%s\n' "$remotes" | grep -Fxq gerrit; then
        skipped "remote gerrit exists"
    else
        init_gerrit "$name" "$backend"
    fi

    # Summary
    printf '\nSummary%s\n' "$([ "$DRY" -eq 1 ] && echo ' (dry run, nothing written)')"
    printf 'Created:\n'
    printf '%s' "$CREATED" | sed 's/^/  /'
    printf 'Skipped:\n'
    printf '%s' "$SKIPPED" | sed 's/^/  /'
    if [ -n "$HUMAN" ]; then
        printf 'Left for you:\n'
        printf '%s' "$HUMAN" | sed 's/^/  /'
    fi
}

main() {
    local verb type trace count=0
    local -a args=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
        --)
            shift
            args+=("$@")
            break
            ;;
        --verbose) count=$((count + 1)) ;;
        -v*)
            if [[ "$1" =~ ^-v+$ ]]; then
                count=$((count + ${#1} - 1))
            else
                args+=("$1")
            fi
            ;;
        *) args+=("$1") ;;
        esac
        shift
    done
    set -- ${args[@]+"${args[@]}"}
    if [ "$count" -gt 0 ]; then
        VERBOSE=$(verbose_level "$count")
    else
        VERBOSE=$(verbose_level "${VERBOSE:-}")
    fi
    if [ "$VERBOSE" -ge 1 ]; then
        export VERBOSE
    else
        export -n VERBOSE
    fi
    if [ "$VERBOSE" -ge 2 ]; then
        trace=$(trace_file)
        if [ -f "$trace" ]; then
            export BASH_ENV=$trace PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
            set -x
        else
            printf 'dev: trace file %s is missing, showing commands only\n' "$trace" >&2
            VERBOSE=1
        fi
    fi

    ROOT=$(repo_root)
    if [ "$#" -eq 0 ]; then
        set -- help
    fi
    verb=$1
    shift
    case "$verb" in
    -h | --help) verb=help ;;
    __verbs)
        verbs_table
        return 0
        ;;
    __flags)
        verb_flags "${1:-}"
        printf '%s\n' -v --verbose -vv
        return 0
        ;;
    esac
    if [ "$verb" = help ]; then
        if has_override help; then
            run_script help "$@"
        fi
        cmd_help "$@"
        return 0
    fi
    case " $VERBS " in
    *" $verb "*) ;;
    *)
        if [[ "$verb" =~ ^[A-Za-z0-9_-]+$ ]] && has_override "$verb"; then
            run_script "$verb" "$@"
        fi
        printf 'dev: unknown verb %s\n\n' "$verb" >&2
        usage >&2
        exit 2
        ;;
    esac

    if [ "$verb" = sync ] && ! has_override sync; then
        cmd_sync "$@"
        return
    fi
    if has_override "$verb"; then
        run_script "$verb" "$@"
    fi
    if [ "$verb" = init ]; then
        cmd_init "$@"
        return
    fi
    if [ "$verb" = push ]; then
        cmd_push "$@"
        return
    fi
    if [ "$verb" = pull ]; then
        cmd_pull "$@"
        return
    fi
    if [ "$verb" = deploy ]; then
        die "deploy has no built-in, add .dev/deploy.sh"
    fi

    type=$(detect_type)
    case "$type" in
    rust | love2d | lua | godot | node | make) "builtin_$type" "$verb" "$@" ;;
    *) unsupported "$verb" undetected ;;
    esac
}

main "$@"
