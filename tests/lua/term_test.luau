local testing = require("@dev/testing")
local term = require("@dev/term")

local Key = term.Key

testing.test("decode names the arrow keys from both escape forms and the vi keys", function()
    testing.eq(term.decode("\27[A"), { Key.UP })
    testing.eq(term.decode("\27OA"), { Key.UP })
    testing.eq(term.decode("k"), { Key.UP })
    testing.eq(term.decode("\16"), { Key.UP })
    testing.eq(term.decode("\27[B"), { Key.DOWN })
    testing.eq(term.decode("\27OB"), { Key.DOWN })
    testing.eq(term.decode("j"), { Key.DOWN })
    testing.eq(term.decode("\14"), { Key.DOWN })
end)

testing.test("decode names page, home and end keys in each common form", function()
    testing.eq(term.decode("\27[5~"), { Key.PGUP })
    testing.eq(term.decode("\27[6~"), { Key.PGDN })
    testing.eq(term.decode("\27[H"), { Key.HOME })
    testing.eq(term.decode("\27OH"), { Key.HOME })
    testing.eq(term.decode("\27[1~"), { Key.HOME })
    testing.eq(term.decode("\27[F"), { Key.END })
    testing.eq(term.decode("\27OF"), { Key.END })
    testing.eq(term.decode("\27[4~"), { Key.END })
end)

testing.test("decode names enter, esc, ctrl-c and space", function()
    testing.eq(term.decode("\r"), { Key.ENTER })
    testing.eq(term.decode("\n"), { Key.ENTER })
    testing.eq(term.decode("\27"), { Key.ESC })
    testing.eq(term.decode("\3"), { Key.CTRL_C })
    testing.eq(term.decode(" "), { Key.SPACE })
end)

testing.test("decode passes any other printable byte through", function()
    testing.eq(term.decode("q"), { "q" })
    testing.eq(term.decode("7"), { "7" })
end)

testing.test("decode reads a run of keys in order", function()
    testing.eq(term.decode("\27[A\27[Bq"), { Key.UP, Key.DOWN, "q" })
end)

testing.test("decode skips an escape sequence it does not know", function()
    testing.eq(term.decode("\27[3~q"), { "q" })
end)

testing.test("size returns a positive row and column count", function()
    local rows, cols = term.size()
    testing.ok(rows > 0 and cols > 0)
end)
